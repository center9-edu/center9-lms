{
  "name": "center9-lms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11.10.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @center9/api --filter @center9/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose --env-file .env -f infra/docker/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/docker/compose.yaml down",
    "db:generate": "pnpm --filter @center9/database build",
    "db:migrate:dev": "pnpm --filter @center9/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @center9/database migrate:deploy",
    "db:migrate:status": "pnpm --filter @center9/database migrate:status"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
