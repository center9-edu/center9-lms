DATABASE_URL=postgresql://center9:local-dev-only@localhost:5433/center9_lms?schema=public

PORT=3001

# Where lesson files (PDF/DOCX) are stored. Relative paths start from apps/api.
# Back this folder up together with the database.
UPLOAD_DIR=./uploads

# Code runner used by /luyen-tap. For local development run `pnpm judge0:fake`.
JUDGE0_URL=http://127.0.0.1:2358
# Required for a real Judge0 instance; the local fake ignores them.
JUDGE0_AUTHN_TOKEN=
JUDGE0_AUTHZ_TOKEN=
